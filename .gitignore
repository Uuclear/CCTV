# --- Python / backend ---
backend/.venv/
backend/.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
*.egg

# Local database & runtime files (never commit)
data/
backend/data/
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri / desktop build ---
frontend/src-tauri/target/
frontend/src-tauri/gen/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Cursor / agent (local only) ---
.cursor/

# --- Office lock files ---
~$*
*.tmp

# --- Large field assets (keep local) ---
视频/
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv

# Optional: large reference PDFs (uncomment if needed)
# reference/**/*.pdf

# --- Secrets (never commit) ---
*.pem
*.key
credentials.json
secrets.*
